{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  }
}
