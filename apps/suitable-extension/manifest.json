{
  "manifest_version": 3,
  "name": "Suitable \u2192 Amodomio",
  "version": "1.3.2",
  "description": "Integra o Suitable ao Amodomio, com configurações globais e integrações por área, incluindo o KDS.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
