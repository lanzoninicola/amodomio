{
  "name": "amodomio-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "57.1.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "24.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:login": "eas login",
    "eas:setup": "eas init && eas update:configure",
    "build:preview": "eas build --profile preview --platform all",
    "build:android": "eas build --profile production --platform android",
    "build:android:local": "bash scripts/build-android-local.sh",
    "build:ios": "eas build --profile production --platform ios",
    "update:preview": "eas update --channel preview --environment production",
    "update:production": "eas update --channel production --environment production",
    "device:register": "eas device:create"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
