{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bio.amodomio.com.br"
        }
      ],
      "destination": "https://www.amodomio.com.br/bio",
      "permanent": true
    }
  ]
}